# LLM Provider (OpenAI-compatible endpoint; DeepSeek verified)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Optional OpenAlex API key (free key gives $1/day dedicated quota;
# if unset, live filter queries work within budget and automatically fall back
# to the verified local OpenAlex 2018-2025 snapshot with explicit provenance)
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Server ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
