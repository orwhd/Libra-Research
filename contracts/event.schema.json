{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/libra-research/contracts/event.v2.schema.json",
  "title": "Libra Research Reproduce HarnessEvent V2 (V1 compatible)",
  "description": "Event-sourced, publicly displayable research action summary. No private chain-of-thought.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "seq",
    "occurred_at",
    "type",
    "target_ids",
    "summary",
    "payload",
    "evidence_ids",
    "artifact_ids",
    "mode"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z]+(?:[._][a-z_]+)+$"
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "subject": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "run",
            "agent",
            "task",
            "debate",
            "pod",
            "artifact",
            "evidence",
            "paper",
            "collaboration"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "simulation"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "harness",
        "sdk",
        "runner",
        "validator",
        "user",
        null
      ]
    }
  }
}
